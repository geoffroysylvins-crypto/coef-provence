  "description": "Portail Sylvins: Agrégateur de catalogues vins de Provence avec authentification et audit.",
  "main": "generate-catalogs.js",
  "scripts": {
    "generate": "node generate-all-catalogs-v4.js",
    "generate:users": "node generate-users.js",
    "generate:users:test": "node generate-test-users.js",
    "generate:clients": "node generate-clients-from-notion.js",
    "generate:all": "npm run generate:users && npm run generate:clients && npm run generate",
    "generate:from-notion": "node generate-from-notion.js",
    "sync:audit": "node sync-audit-logs.js",
    "deploy": "bash ./deploy.sh",
    "deploy:github": "DEPLOY_TARGET=github bash ./deploy.sh",
    "deploy:hostinger": "DEPLOY_TARGET=hostinger bash ./deploy.sh",
    "serve": "python3 -m http.server 8000",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoffroysylvins-crypto/coef-provence.git"
  },
  "keywords": [
    "wines",
