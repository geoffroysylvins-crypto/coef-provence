    {
      "parameters": {
        "javaScriptCode": "// Classification logic pour les emails\nconst senderEmail = $json.from;\nconst mailBody = $json.body ? $json.body.toLowerCase() : '';\nconst mailSubject = $json.subject ? $json.subject.toLowerCase() : '';\nconst fullContent = `${mailSubject} ${mailBody}`;\n\nlet actionType = null;\n\n// Mots-clés pour différents types d'actions\nconst allocationKeywords = /allocation|demande allocation|accès catalogue/i;\nconst orderKeywords = /commande|commander|je passe commande|order|je voudrais commander/i;\nconst breakageKeywords = /casse|bouteille cass[ée]|bouchonnée|problème livraison|casse livraison/i;\nconst deliveryKeywords = /où en est|suivi livraison|quand livraison|tracking|localisation|où en est/i;\nconst priceKeywords = /tarif|prix|devis|combien ça coûte|quel est votre prix|catalogue de prix/i;\nconst meetingKeywords = /rendez-vous|rdv|visite|peut-on se voir|meeting|commercial|visite commerciale/i;\nconst supplierPriceKeywords = /tarif|prix|liste|catalogue|nouveau tarif|nouveaux prix/i;\nconst invoiceKeywords = /facture|invoice|relance|paiement|règlement|bon de livraison/i;\n\n// Déterminer le type d'action\nif (orderKeywords.test(fullContent)) {\n  actionType = 'NEW_ORDER';\n} else if (allocationKeywords.test(fullContent)) {\n  actionType = 'ALLOCATION_REQUEST';\n} else if (breakageKeywords.test(fullContent)) {\n  actionType = 'DELIVERY_ISSUE';\n} else if (deliveryKeywords.test(fullContent)) {\n  actionType = 'DELIVERY_TRACKING';\n} else if (priceKeywords.test(fullContent)) {\n  actionType = 'PRICE_REQUEST';\n} else if (meetingKeywords.test(fullContent)) {\n  actionType = 'MEETING_REQUEST';\n} else if (supplierPriceKeywords.test(fullContent)) {\n  actionType = 'SUPPLIER_NEW_PRICES';\n} else if (invoiceKeywords.test(fullContent)) {\n  actionType = 'SUPPLIER_INVOICE';\n}\n\nreturn {\n  ...input.item.json,\n  actionType,\n  senderEmail,\n  fullContent,\n  timestamp: new Date().toISOString()\n};"
      },
