# N8N Consultant - GitIgnore

# Configuration sensibles
mcp-config-generated.json
.env
.env.local
*.key

# API Keys et credentials
**/credentials.json
**/api-keys.txt

# Logs
*.log
logs/
*.log.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (si vous ajoutez des dépendances)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup

# N8N specific
.n8n/
